    },
    {
      "type": "facade",
      "modes": { "storeys": "upper", "opening": "window" },
      "props": { "bayWidth": 2.1, "windowWidth": 1, "pierWidth": 0.5, "sillHeight": 0.85, "lintelHeight": 0.35 }
    },
    {
